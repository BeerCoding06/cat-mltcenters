Options -Indexes
DirectoryIndex index.php

RewriteEngine On

# Private folders and files
RewriteRule ^(data|inc|bin|views|docs|deploy|docker|content)(/|$) - [F,L]
RewriteRule ^README\.md$ - [F,L]
RewriteRule ^(config|config\.sample|router)\.php$ - [F,L]
RewriteRule ^Dockerfile - [F,L]
RewriteRule (^|/)\. - [F,L]

# Everything that is not a real file or folder goes to the front controller
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.php [QSA,L]

# Browser caching: CSS/JS URLs carry ?v=<mtime>, so they can be kept for a year; other static files for a month.
<IfModule mod_headers.c>
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(svg|jpg|jpeg|png|webp|ico|woff2?)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
</IfModule>
