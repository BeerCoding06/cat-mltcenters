<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  macOS schedule: refresh the cat breed pages (Wikidata + Thai Wikipedia) on the 1st of every month at 04:00.
  If the Mac is asleep at that time, launchd runs it once when the Mac wakes up.

  Install:   cp deploy/com.deeltasmaew.fetch-breeds.plist ~/Library/LaunchAgents/
             launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.deeltasmaew.fetch-breeds.plist
  Remove:    launchctl bootout gui/$(id -u)/com.deeltasmaew.fetch-breeds
             rm ~/Library/LaunchAgents/com.deeltasmaew.fetch-breeds.plist
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.deeltasmaew.fetch-breeds</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Applications/MAMP/bin/php/php8.2.0/bin/php</string>
    <string>/Applications/MAMP/htdocs/cat-mltcenters/bin/fetch-breeds.php</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Day</key>
    <integer>1</integer>
    <key>Hour</key>
    <integer>4</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>
  <key>StandardOutPath</key>
  <string>/Applications/MAMP/htdocs/cat-mltcenters/data/fetch-breeds.log</string>
  <key>StandardErrorPath</key>
  <string>/Applications/MAMP/htdocs/cat-mltcenters/data/fetch-breeds.log</string>
</dict>
</plist>
