<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  macOS schedule: fetch cat news headlines 3 times a day (07:00, 13:00, 19:00).
  If the Mac is asleep at those times, launchd runs it once when the Mac wakes up.

  Install:   cp deploy/com.deeltasmaew.fetch-news.plist ~/Library/LaunchAgents/
             launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.deeltasmaew.fetch-news.plist
  Remove:    launchctl bootout gui/$(id -u)/com.deeltasmaew.fetch-news
             rm ~/Library/LaunchAgents/com.deeltasmaew.fetch-news.plist
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.deeltasmaew.fetch-news</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Applications/MAMP/bin/php/php8.2.0/bin/php</string>
    <string>/Applications/MAMP/htdocs/cat-mltcenters/bin/fetch-news.php</string>
  </array>
  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Hour</key><integer>7</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Hour</key><integer>13</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Hour</key><integer>19</integer><key>Minute</key><integer>0</integer></dict>
  </array>
  <key>StandardOutPath</key>
  <string>/Applications/MAMP/htdocs/cat-mltcenters/data/fetch-news.log</string>
  <key>StandardErrorPath</key>
  <string>/Applications/MAMP/htdocs/cat-mltcenters/data/fetch-news.log</string>
</dict>
</plist>
